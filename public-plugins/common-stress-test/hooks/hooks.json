{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "mcp_tool",
            "server": "plugin:common-stress-test:stress-hook",
            "tool": "stress_target_validate",
            "input": {
              "tool_name": "${tool_name}",
              "hook_event_name": "${hook_event_name}",
              "cwd": "${cwd}",
              "tool_input": "${tool_input}"
            },
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "mcp_tool",
            "server": "plugin:common-stress-test:stress-hook",
            "tool": "stress_script_validate",
            "input": {
              "tool_name": "${tool_name}",
              "hook_event_name": "${hook_event_name}",
              "cwd": "${cwd}",
              "tool_input": "${tool_input}"
            },
            "timeout": 10
          }
        ]
      }
    ]
  }
}
