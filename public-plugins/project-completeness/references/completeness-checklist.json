  "categories": [
    {"id": "code", "title": "코드", "iso": "Maintainability", "items": [
      {"id": "code.lint-ci", "text": "린터·포매터가 CI에서 강제되는가", "critical": true, "mode": "auto", "how": "CI 워크플로에 lint step + 린터 설정 파일(eslint.config.*/.eslintrc*/biome.json/.golangci.y*ml/pyproject[tool.ruff])"},
      {"id": "code.type-strict", "text": "타입 체크가 strict 모드로 통과하는가", "critical": false, "mode": "auto", "how": "tsconfig strict / mypy strict / .golangci govet·staticcheck 활성"},
      {"id": "code.quality-gate", "text": "Quality Gate(신규 코드 기준)가 PR을 차단하는가", "critical": true, "mode": "auto", "how": "PR 트리거 워크플로가 존재하고 실패 시 차단되는가 (continue-on-error 아님)"},
      {"id": "code.duplication", "text": "중복 코드 비율이 5% 미만인가", "critical": false, "mode": "run", "how": "jscpd · dupl · SonarQube 중복률", "cost": "2~5분"},
      {"id": "code.unused-code", "text": "미사용 파일·export·의존성이 0에 수렴하는가 (Knip)", "critical": false, "mode": "run", "how": "knip · depcheck · golangci unused", "cost": "1~3분"},
      {"id": "code.complexity", "text": "순환 복잡도 상위 함수를 파악하고 있는가", "critical": false, "mode": "run", "how": "gocyclo · radon · eslint complexity", "cost": "1~2분"},
      {"id": "code.codeowners", "text": "코드 소유자(CODEOWNERS)가 지정되어 있는가", "critical": false, "mode": "auto", "how": "CODEOWNERS 또는 .github/CODEOWNERS 존재"},
      {"id": "code.ai-provenance", "text": "AI 생성 코드의 출처/프롬프트가 기록되는가", "critical": false, "mode": "auto", "how": "커밋 트레일러·CONTRIBUTING 의 AI 기여 정책. 없으면 ask 로 승격"},
      {"id": "code.architecture-boundary", "text": "아키텍처 경계 위반이 자동 검출되는가", "critical": false, "mode": "auto", "how": "depguard·import-linter·dependency-cruiser 설정"},
      {"id": "code.adr", "text": "ADR(아키텍처 결정 기록)이 유지되는가", "critical": false, "mode": "auto", "how": "docs/adr · doc/adr · ADR 디렉터리"}
    ]},
    {"id": "test", "title": "테스트", "iso": "Functional Suitability", "items": [
      {"id": "test.unit-coverage", "text": "유닛 테스트 커버리지 ≥ 80% (신규 코드 기준)", "critical": false, "mode": "run", "how": "커버리지 실행 후 수치 확인. 게이트는 fail_under·thresholds 설정으로 auto 판정", "cost": "테스트 시간"},
      {"id": "test.mutation-score", "text": "뮤테이션 스코어 ≥ 80%", "critical": false, "mode": "run", "how": "stryker · mutmut · PIT 실행", "cost": "수 분~수십 분"},
      {"id": "test.e2e-flow", "text": "핵심 유저 플로우 E2E 테스트가 존재하는가", "critical": true, "mode": "auto", "how": "e2e·playwright·cypress 디렉터리 또는 통합 테스트 존재"},
      {"id": "test.integration-real-db", "text": "통합 테스트가 실제 DB(Testcontainers)로 수행되는가", "critical": false, "mode": "auto", "how": "testcontainers 의존성 또는 CI service 컨테이너"},
      {"id": "test.contract-test", "text": "계약 테스트(Pact)로 서비스 간 배포 안전성을 판정하는가", "critical": false, "mode": "auto", "how": "pact · pactflow 설정"},
      {"id": "test.visual-regression", "text": "시각 회귀 테스트가 있는가", "critical": false, "mode": "auto", "how": "chromatic · percy · toHaveScreenshot 사용"},
      {"id": "test.flaky-tracking", "text": "플레이키 테스트를 추적·격리하는가", "critical": false, "mode": "ask", "how": "플레이키 추적은 CI 대시보드·재시도 정책에 있어 저장소만으로는 불확실"}
    ]},
    {"id": "security", "title": "보안", "iso": "Security", "items": [
      {"id": "security.secret-scan", "text": "시크릿 스캔이 pre-commit과 CI 양쪽에 있는가", "critical": true, "mode": "auto", "how": "pre-commit 훅과 CI 양쪽에 gitleaks·trufflehog"},
      {"id": "security.sast", "text": "SAST(Semgrep/CodeQL)가 CI에 있는가", "critical": false, "mode": "auto", "how": "CI 에 semgrep · codeql · bandit · gosec"},
      {"id": "security.sca-sbom", "text": "SCA 스캔과 SBOM 생성·보관을 하는가", "critical": false, "mode": "auto", "how": "CI 에 trivy·osv-scanner·snyk + syft·sbom-action"},
      {"id": "security.critical-vulnerability", "text": "Critical/High 취약점이 0인가", "critical": true, "mode": "run", "how": "trivy fs . 또는 osv-scanner -r . 실행해 실제 건수 확인", "cost": "1~3분"},
      {"id": "security.dependency-update", "text": "의존성 자동 갱신(Renovate/Dependabot)이 동작하는가", "critical": true, "mode": "auto", "how": ".github/dependabot.yml 또는 renovate.json"},
      {"id": "security.scorecard", "text": "OpenSSF Scorecard 점수를 알고 있는가", "critical": false, "mode": "run", "how": "scorecard --repo=... 실행. 비공개 저장소는 대부분 체크가 동작하지 않는다", "cost": "2~5분"},
      {"id": "security.iac-scan", "text": "IaC 보안 스캔(Checkov/tfsec)이 있는가", "critical": false, "mode": "auto", "how": "IaC 파일(*.tf, k8s yaml, Dockerfile) 존재 시 checkov·tfsec·kics"},
      {"id": "security.dast", "text": "DAST 또는 침투 테스트 이력이 있는가", "critical": false, "mode": "ask", "how": "DAST·침투 테스트 이력은 저장소 밖에 있다"}
    ]},
    {"id": "perf", "title": "성능", "iso": "Performance Efficiency", "items": [
      {"id": "perf.web-vitals", "text": "Core Web Vitals 필드 데이터를 수집 중인가 (LCP/INP/CLS)", "critical": false, "mode": "auto", "how": "web-vitals 의존성 또는 RUM 스니펫(Clarity·Sentry·SpeedCurve)"},
      {"id": "perf.lighthouse-budget", "text": "Lighthouse CI 성능 예산이 PR을 게이트하는가", "critical": false, "mode": "auto", "how": "lighthouserc* 존재 + CI 에서 lhci autorun"},
      {"id": "perf.bundle-budget", "text": "번들 예산이 CI에 있는가", "critical": false, "mode": "auto", "how": "size-limit·bundlewatch 설정 + CI step"},
      {"id": "perf.latency-baseline", "text": "백엔드 p95/p99 지연 기준선이 문서화되어 있는가", "critical": false, "mode": "ask", "how": "p95/p99 기준선 문서는 저장소 밖(위키·대시보드)에 있는 경우가 많다"},
      {"id": "perf.load-test", "text": "부하 테스트로 포화점(saturation knee)을 알고 있는가", "critical": false, "mode": "auto", "how": "k6·gatling·locust 스크립트 존재. 실제 포화점 수치는 ask"},
      {"id": "perf.slow-query", "text": "DB slow query를 모니터링하는가", "critical": false, "mode": "ask", "how": "DB slow query 모니터링은 인프라 설정에 있다"},
      {"id": "perf.n-plus-one", "text": "N+1 쿼리·불필요 리렌더 점검 이력이 있는가", "critical": false, "mode": "ask", "how": "N+1·리렌더 점검 이력은 PR·이슈 기록을 봐야 한다"}
    ]},
    {"id": "ux", "title": "접근성 · UX", "iso": "Interaction Capability", "items": [
      {"id": "ux.a11y-automated", "text": "axe/Pa11y CI 위반이 0인가", "critical": false, "mode": "run", "how": "axe·pa11y 를 실제 실행. 설정 파일 존재만으로는 위반 0 을 알 수 없다", "cost": "3~10분(브라우저 필요)"},
      {"id": "ux.a11y-manual", "text": "수동 스크린리더·키보드 테스트 이력이 있는가", "critical": false, "mode": "ask", "how": "수동 스크린리더 테스트 이력은 저장소에 남지 않는다"},
      {"id": "ux.wcag22", "text": "WCAG 2.2 (ISO/IEC 40500:2025) 기준을 적용하는가", "critical": false, "mode": "auto", "how": "axe withTags 에 wcag22aa 포함 여부 · 접근성 문서"},
      {"id": "ux.usability-measure", "text": "SUS 또는 과업 성공률 측정 이력이 있는가", "critical": false, "mode": "ask", "how": "SUS·과업 성공률은 리서치 도구에 있다"},
      {"id": "ux.rage-click", "text": "rage click / dead click을 모니터링하는가", "critical": false, "mode": "auto", "how": "Clarity·Hotjar·LogRocket 스니펫 존재"},
      {"id": "ux.ia-validation", "text": "정보구조(IA) 검증(트리테스트/카드소팅) 이력이 있는가", "critical": false, "mode": "ask", "how": "IA 검증 이력은 리서치 도구에 있다"}
    ]},
    {"id": "ops", "title": "운영", "iso": "Reliability · Safety", "items": [
      {"id": "ops.tracing", "text": "OpenTelemetry 계측으로 end-to-end 트레이스가 이어지는가", "critical": false, "mode": "auto", "how": "@opentelemetry/* · opentelemetry-* 의존성과 계측 초기화 파일"},
      {"id": "ops.slo", "text": "핵심 여정에 SLO와 에러버짓이 있는가", "critical": true, "mode": "auto", "how": "SLO 정의(openslo·sloth·nobl9·grafana slo) 파일. 준수율은 service_health 로"},
      {"id": "ops.oncall-runbook", "text": "온콜·에스컬레이션·런북이 정의되어 있는가", "critical": true, "mode": "auto", "how": "docs/runbooks · 온콜 설정 · alertmanager 라우팅"},
      {"id": "ops.status-page", "text": "상태 페이지와 장애 커뮤니케이션 절차가 있는가", "critical": false, "mode": "ask", "how": "상태 페이지는 외부 서비스다"},
      {"id": "ops.synthetic-monitoring", "text": "합성 모니터링이 핵심 플로우를 상시 검증하는가", "critical": false, "mode": "auto", "how": "checkly·__checks__ · 합성 모니터링 설정"},
      {"id": "ops.rollback", "text": "롤백 또는 피처플래그로 즉시 되돌릴 수 있는가", "critical": true, "mode": "auto", "how": "피처 플래그 SDK(growthbook·unleash·launchdarkly) 또는 롤백 워크플로"},
