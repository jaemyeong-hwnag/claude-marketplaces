{
  "prune": ["node_modules", ".git", "dist", "build", "target", ".gradle", ".idea", ".venv", "venv", "__pycache__", "vendor", ".next", "coverage", "out", ".claude", ".terraform"],
  "signals": [
    { "id": "java", "label": "Java", "weight": 3, "exclusive": true, "terms": ["java"], "paths": ["\\.java$", "(^|/)pom\\.xml$"] },
    { "id": "kotlin", "label": "Kotlin", "weight": 3, "exclusive": true, "terms": ["kotlin"], "paths": ["\\.kt$"] },
    { "id": "spring", "label": "Spring", "weight": 3, "exclusive": true, "terms": ["spring", "spring-boot"], "grep": [{ "path": "(^|/)(pom\\.xml|build\\.gradle(\\.kts)?|libs\\.versions\\.toml)$", "pattern": "spring-boot|springframework" }] },
    { "id": "gradle", "label": "Gradle", "weight": 1, "exclusive": false, "terms": ["gradle"], "paths": ["(^|/)build\\.gradle(\\.kts)?$", "(^|/)settings\\.gradle(\\.kts)?$"] },
    { "id": "maven", "label": "Maven", "weight": 1, "exclusive": false, "terms": ["maven"], "paths": ["(^|/)pom\\.xml$"] },
    { "id": "node", "label": "Node.js", "weight": 3, "exclusive": true, "terms": ["node", "nodejs", "npm"], "paths": ["(^|/)package\\.json$"] },
    { "id": "typescript", "label": "TypeScript", "weight": 3, "exclusive": true, "terms": ["typescript"], "paths": ["(^|/)tsconfig[^/]*\\.json$", "\\.tsx?$"] },
    { "id": "react", "label": "React", "weight": 2, "exclusive": true, "terms": ["react", "nextjs"], "grep": [{ "path": "(^|/)package\\.json$", "pattern": "\"(react|next)\"[[:space:]]*:" }] },
    { "id": "vue", "label": "Vue", "weight": 2, "exclusive": true, "terms": ["vue", "nuxt"], "grep": [{ "path": "(^|/)package\\.json$", "pattern": "\"(vue|nuxt)\"[[:space:]]*:" }] },
    { "id": "python", "label": "Python", "weight": 3, "exclusive": true, "terms": ["python"], "paths": ["(^|/)(pyproject\\.toml|setup\\.py|requirements[^/]*\\.txt|Pipfile)$", "\\.py$"] },
    { "id": "django", "label": "Django", "weight": 2, "exclusive": true, "terms": ["django"], "grep": [{ "path": "(^|/)(pyproject\\.toml|requirements[^/]*\\.txt|Pipfile)$", "pattern": "[Dd]jango" }] },
    { "id": "fastapi", "label": "FastAPI", "weight": 2, "exclusive": true, "terms": ["fastapi"], "grep": [{ "path": "(^|/)(pyproject\\.toml|requirements[^/]*\\.txt|Pipfile)$", "pattern": "fastapi" }] },
    { "id": "go", "label": "Go", "weight": 3, "exclusive": true, "terms": ["go", "golang"], "paths": ["(^|/)go\\.mod$"] },
    { "id": "rust", "label": "Rust", "weight": 3, "exclusive": true, "terms": ["rust", "cargo"], "paths": ["(^|/)Cargo\\.toml$"] },
    { "id": "ruby", "label": "Ruby", "weight": 3, "exclusive": true, "terms": ["ruby", "rails"], "paths": ["(^|/)Gemfile$"] },
    { "id": "php", "label": "PHP", "weight": 3, "exclusive": true, "terms": ["php", "laravel"], "paths": ["(^|/)composer\\.json$"] },
    { "id": "swift", "label": "Swift", "weight": 3, "exclusive": true, "terms": ["swift", "ios", "xcode"], "paths": ["(^|/)Package\\.swift$", "\\.xcodeproj/"] },
    { "id": "docker", "label": "Docker", "weight": 2, "exclusive": false, "terms": ["docker", "container"], "paths": ["(^|/)Dockerfile[^/]*$", "(^|/)(docker-)?compose[^/]*\\.ya?ml$"] },
    { "id": "k8s", "label": "Kubernetes", "weight": 2, "exclusive": false, "terms": ["k8s", "kubernetes", "helm"], "paths": ["(^|/)Chart\\.yaml$", "(^|/)kustomization\\.ya?ml$", "(^|/)(k8s|kubernetes|manifests)/"] },
    { "id": "terraform", "label": "Terraform", "weight": 2, "exclusive": false, "terms": ["terraform", "iac"], "paths": ["\\.tf$"] },
    { "id": "github", "label": "GitHub", "weight": 2, "exclusive": false, "terms": ["github"], "paths": ["^\\.github/"] },
    { "id": "gitlab", "label": "GitLab", "weight": 2, "exclusive": false, "terms": ["gitlab"], "paths": ["(^|/)\\.gitlab-ci\\.ya?ml$"] },
    { "id": "database", "label": "데이터베이스", "weight": 2, "exclusive": false, "terms": ["database", "sql", "migration"], "paths": ["\\.sql$", "(^|/)(migrations?|flyway|liquibase)/", "(^|/)schema\\.prisma$"] },
    { "id": "test", "label": "테스트", "weight": 1, "exclusive": false, "terms": ["test", "coverage"], "paths": ["(^|/)(tests?|__tests__|spec)/", "(^|/)src/test/", "(_test\\.go|\\.test\\.[jt]sx?|\\.spec\\.[jt]sx?|_test\\.py|Test\\.(java|kt))$"] },
    { "id": "docs", "label": "문서", "weight": 1, "exclusive": false, "terms": ["document", "documentation"], "paths": ["^docs?/.+\\.md$"] },
    { "id": "openapi", "label": "OpenAPI", "weight": 2, "exclusive": false, "terms": ["openapi", "swagger", "api"], "paths": ["(^|/)(openapi|swagger)[^/]*\\.(ya?ml|json)$"] },
    { "id": "claude-plugin", "label": "Claude Code 플러그인", "weight": 2, "exclusive": false, "terms": ["plugin", "marketplace", "skill"], "paths": ["(^|/)\\.claude-plugin/(plugin|marketplace)\\.json$"] },
    { "id": "mcp", "label": "MCP 서버 설정", "weight": 1, "exclusive": false, "terms": ["mcp"], "paths": ["^\\.mcp\\.json$"] },
    { "id": "notion", "label": "Notion", "weight": 1, "exclusive": false, "terms": ["notion"], "grep": [{ "path": "^(\\.mcp\\.json|package\\.json)$", "pattern": "notion" }] },
    { "id": "slack", "label": "Slack", "weight": 1, "exclusive": false, "terms": ["slack"], "grep": [{ "path": "^(\\.mcp\\.json|package\\.json)$", "pattern": "slack" }] },
    { "id": "vercel", "label": "Vercel", "weight": 2, "exclusive": false, "terms": ["vercel"], "paths": ["(^|/)vercel\\.json$", "^\\.vercel/"] },
    { "id": "monitoring", "label": "모니터링", "weight": 1, "exclusive": false, "terms": ["monitoring", "sentry", "datadog", "opentelemetry"], "grep": [{ "path": "(^|/)(package\\.json|pyproject\\.toml|requirements[^/]*\\.txt|build\\.gradle(\\.kts)?|pom\\.xml|go\\.mod)$", "pattern": "sentry|datadog|opentelemetry|prometheus|newrelic" }] },
    { "id": "figma", "label": "Figma", "weight": 1, "exclusive": false, "terms": ["figma", "design"], "grep": [{ "path": "^(\\.mcp\\.json|package\\.json)$", "pattern": "figma" }] }
  ]
}
