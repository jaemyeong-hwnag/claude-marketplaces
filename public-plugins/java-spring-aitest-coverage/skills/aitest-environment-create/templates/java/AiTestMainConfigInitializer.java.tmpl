package {{PACKAGE}};

import java.io.IOException;
import java.util.List;
import org.springframework.boot.env.YamlPropertySourceLoader;
import org.springframework.context.ApplicationContextInitializer;
import org.springframework.context.ConfigurableApplicationContext;
import org.springframework.core.env.PropertySource;
import org.springframework.core.io.Resource;
import org.springframework.core.io.support.PathMatchingResourcePatternResolver;

/**
 * aiTest 소스셋 클래스패스에서 main(·프로파일) {@code application.yml} 이 누락될 때 병합한다.
 * test override 는 소비 모듈 {@code src/test/resources/application.yml} 이 우선한다.
 */
public class AiTestMainConfigInitializer
        implements ApplicationContextInitializer<ConfigurableApplicationContext> {

    private static final YamlPropertySourceLoader YAML_LOADER = new YamlPropertySourceLoader();

    @Override
    public void initialize(ConfigurableApplicationContext ctx) {
        try {
            PathMatchingResourcePatternResolver resolver = new PathMatchingResourcePatternResolver();
            int index = 0;
            for (Resource resource : resolver.getResources("classpath*:application.yml")) {
                if (!shouldLoad(resource)) {
                    continue;
                }
                List<PropertySource<?>> sources = YAML_LOADER.load("aiTestMainConfig-" + index++, resource);
                for (PropertySource<?> source : sources) {
                    ctx.getEnvironment().getPropertySources().addLast(source);
                }
            }
        } catch (IOException ex) {
            throw new IllegalStateException("aiTest main application.yml 로드 실패", ex);
        }
    }

    private static boolean shouldLoad(Resource resource) throws IOException {
        String url = resource.getURL().toString();
        if (url.contains("/resources/test/") || url.contains("/test/resources/")) {
            return false;
        }
        return url.contains("/resources/main/")
                || url.contains("/main/resources/")
{{#HAS_PROFILE}}                || url.contains("/resources/{{PROFILE}}/")
                || url.contains("/{{PROFILE}}/resources/")
{{/HAS_PROFILE}}                ;
    }
}
