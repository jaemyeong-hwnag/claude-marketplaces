/**
 * MockMvc 로 컨트롤러 경계까지 태우는 통합 테스트용 메타 어노테이션.
 *
 * {@link AiTest} 와 태그·프로파일·testcontainer 구성은 같고 webEnvironment 만 다르다.
 * 파라미터 바인딩·예외 핸들러·응답 JSON 계약처럼 서비스 호출만으로는 검증되지 않는 구간에 쓴다.
 *
 * 실행: ./gradlew :&lt;module&gt;:aiTest
 */
@Target(ElementType.TYPE)
@Retention(RetentionPolicy.RUNTIME)
@Documented
@Inherited
@Tag("AI")
@SpringBootTest(
        webEnvironment = SpringBootTest.WebEnvironment.MOCK,
        properties = "spring.main.allow-bean-definition-overriding=true")
@AutoConfigureMockMvc
{{#HAS_PROFILE}}@ActiveProfiles("{{PROFILE}}")
{{/HAS_PROFILE}}@ContextConfiguration(initializers = {
{{INITIALIZERS}}
})
{{#HAS_DB}}@Transactional
{{/HAS_DB}}public @interface AiWebTest {
}
