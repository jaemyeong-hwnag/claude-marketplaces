package {{PACKAGE}}

{{#BOOT4}}import org.springframework.boot.webmvc.test.autoconfigure.AutoConfigureMockMvc
{{/BOOT4}}{{^BOOT4}}import org.springframework.boot.test.autoconfigure.web.servlet.AutoConfigureMockMvc
{{/BOOT4}}import org.springframework.boot.test.context.SpringBootTest
import org.springframework.context.annotation.Import
{{#HAS_PROFILE}}import org.springframework.test.context.ActiveProfiles
{{/HAS_PROFILE}}import org.springframework.test.context.TestConstructor
{{#HAS_DB}}import org.springframework.transaction.annotation.Transactional
