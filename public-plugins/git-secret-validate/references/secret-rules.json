{
  "patterns": [
    { "id": "private-key", "regex": "-----BEGIN ([A-Z0-9]+ )*PRIVATE KEY( BLOCK)?-----", "meaning": "PEM · OpenSSH · PGP 개인 키" },
    { "id": "aws-access-token", "regex": "(A3T[A-Z0-9]|AKIA|ASIA|ABIA|ACCA)[A-Z2-7]{16}", "meaning": "AWS 액세스 키 ID" },
    { "id": "github-pat", "regex": "gh[pousr]_[0-9A-Za-z]{36,}", "meaning": "GitHub 토큰" },
    { "id": "github-fine-grained-pat", "regex": "github_pat_[0-9A-Za-z_]{40,}", "meaning": "GitHub 세분화 토큰" },
    { "id": "gitlab-pat", "regex": "glpat-[0-9A-Za-z_-]{20,}", "meaning": "GitLab 토큰" },
    { "id": "slack-token", "regex": "xox[abposr]-[0-9A-Za-z-]{10,}", "meaning": "Slack 토큰" },
    { "id": "slack-webhook-url", "regex": "hooks\\.slack\\.com/(services|workflows|triggers)/[A-Za-z0-9+/]{20,}", "meaning": "Slack 웹훅 URL" },
    { "id": "gcp-api-key", "regex": "AIza[0-9A-Za-z_-]{35}", "meaning": "Google API 키" },
    { "id": "stripe-access-token", "regex": "(sk|rk)_live_[0-9A-Za-z]{20,}", "meaning": "Stripe 라이브 키" },
    { "id": "anthropic-api-key", "regex": "sk-ant-(api|admin)[0-9]{2}-[0-9A-Za-z_-]{80,}", "meaning": "Anthropic API 키" },
    { "id": "openai-api-key", "regex": "sk-(proj|svcacct|admin)-[0-9A-Za-z_-]{40,}", "meaning": "OpenAI API 키" },
    { "id": "npm-access-token", "regex": "npm_[0-9A-Za-z]{36}", "meaning": "npm 토큰" },
    { "id": "jwt", "regex": "eyJ[0-9A-Za-z_-]{10,}\\.eyJ[0-9A-Za-z_-]{10,}\\.[0-9A-Za-z_-]{10,}", "meaning": "JWT" },
    { "id": "url-credential", "regex": "[a-z][a-z0-9+.-]*://[^/[:space:]:@\"']+:[^/[:space:]:@\"'$<{]{3,}@[^[:space:]\"']+", "meaning": "URL 에 넣은 사용자 · 비밀번호" },
    {
      "id": "generic-secret",
      "regex": "(password|passwd|pwd|secret|api[_-]?key|access[_-]?key|auth[_-]?token|access[_-]?token|client[_-]?secret|private[_-]?key)[A-Za-z0-9_]*[\"']?[[:space:]]*[:=][[:space:]]*[\"'][^\"'[:space:]]{8,}[\"']",
      "flags": "i",
      "meaning": "이름이 비밀번호 · 키인 변수에 문자열을 직접 넣음"
    }
  ],
  "placeholder": "(\\$\\{|\\$[A-Z_]|<[A-Za-z_-]+>|\\{\\{|example|changeme|change-me|xxxx|dummy|placeholder|your[_-]|redacted|\\*\\*\\*|getenv|environ)",
  "sensitive_files": {
    "deny": [
      ".env",
      ".env.*",
      "*.env",
      "*.pem",
      "*.key",
      "*.p12",
      "*.pfx",
      "*.jks",
      "*.keystore",
      "*.ppk",
      "*.kdbx",
      "*.tfstate",
      "*.tfstate.backup",
      "id_rsa",
      "id_dsa",
      "id_ecdsa",
      "id_ed25519",
      ".netrc",
      ".pgpass",
      ".htpasswd",
      "credentials.json",
      "client_secret*.json",
      "service-account*.json",
      "secrets.yml",
      "secrets.yaml"
    ],
    "allow": [
      ".env.example",
      ".env.sample",
      ".env.template",
      ".env.dist",
      ".env.defaults",
      "*.example",
      "*.sample",
      "*.template",
      "*.pub"
    ]
  }
}
