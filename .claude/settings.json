{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.claude/hooks/sync-internal-plugins.sh\"",
            "timeout": 60
          },
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.claude/hooks/validate-plugin-scope.sh\"",
            "timeout": 15
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "github-workflow@jaemyeong-hwnag-plugins": true,
    "marketplace-directory-structure@jaemyeong-hwnag-plugins": true,
    "plugin-authoring@jaemyeong-hwnag-plugins": true,
    "plugin-dependency@jaemyeong-hwnag-plugins": true,
    "plugin-naming@jaemyeong-hwnag-plugins": true,
    "plugin-versioning@jaemyeong-hwnag-plugins": true,
    "plugin-workflow@jaemyeong-hwnag-plugins": true
  },
  "extraKnownMarketplaces": {
    "jaemyeong-hwnag-plugins": {
      "source": {
        "source": "directory",
        "path": "."
      }
    }
  }
}
